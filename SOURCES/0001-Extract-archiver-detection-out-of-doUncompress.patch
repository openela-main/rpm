From e231b5bc8a8cb73d509f1a681ab70072a494d3c6 Mon Sep 17 00:00:00 2001
From: Michal Domonkos <mdomonko@redhat.com>
Date: Fri, 23 Oct 2026 14:01:04 +0200
Subject: [PATCH 1/3] Extract archiver detection out of doUncompress()

Move the logic to determine the command line string to an internal macro
API function called rpmGetArchiver(). This will be needed in the
subsequent commit.

No functional change.

Backported from commit 7aabd4c44b5cf015ac3854cc16fc23e23a87f224:

- There's no doUncompress() yet and the logic is in doFoo(), so adjust
  that instead.

- There's also no rpmio/rpmmacro_internal.h so declare rpmGetArchive()
  in rpmio/rpmio_internal.h instead (not ideal, but this is not a beauty
  contest).
---
 rpmio/macro.c          | 80 +++++++++++++++++++++++++-----------------
 rpmio/rpmio_internal.h |  8 +++++
 2 files changed, 55 insertions(+), 33 deletions(-)

diff --git a/rpmio/macro.c b/rpmio/macro.c
index ed10d93d8..067152064 100644
--- a/rpmio/macro.c
+++ b/rpmio/macro.c
@@ -34,6 +34,7 @@ extern int optind;
 #include "rpmio/rpmlua.h"
 #endif
 
+#include "rpmio/rpmio_internal.h"
 #include "debug.h"
 
 enum macroFlags_e {
@@ -931,44 +932,14 @@ doFoo(MacroBuf mb, int negate, const char * f, size_t fn,
 	(void)urlPath(buf, (const char **)&b);
 	if (*b == '\0') b = "/";
     } else if (STREQ("uncompress", f, fn)) {
-	rpmCompressedMagic compressed = COMPRESSED_OTHER;
+	const char *cmd = NULL;
 	for (b = buf; (c = *b) && isblank(c);)
 	    b++;
 	for (be = b; (c = *be) && !isblank(c);)
 	    be++;
 	*be++ = '\0';
-	(void) rpmFileIsCompressed(b, &compressed);
-	switch (compressed) {
-	default:
-	case COMPRESSED_NOT:
-	    sprintf(be, "%%__cat %s", b);
-	    break;
-	case COMPRESSED_OTHER:
-	    sprintf(be, "%%__gzip -dc %s", b);
-	    break;
-	case COMPRESSED_BZIP2:
-	    sprintf(be, "%%__bzip2 -dc %s", b);
-	    break;
-	case COMPRESSED_ZIP:
-	    sprintf(be, "%%__unzip %s", b);
-	    break;
-        case COMPRESSED_LZMA:
-        case COMPRESSED_XZ:
-            sprintf(be, "%%__xz -dc %s", b);
-            break;
-	case COMPRESSED_LZIP:
-	    sprintf(be, "%%__lzip -dc %s", b);
-	    break;
-	case COMPRESSED_LRZIP:
-	    sprintf(be, "%%__lrzip -dqo- %s", b);
-	    break;
-	case COMPRESSED_7ZIP:
-	    sprintf(be, "%%__7zip x %s", b);
-	    break;
-	case COMPRESSED_ZSTD:
-	    sprintf(be, "%%__zstd -dc %s", b);
-	    break;
-	}
+	cmd = rpmGetArchiver(b);
+	sprintf(be, "%s%s", cmd, b);
 	b = be;
     } else if (STREQ("getenv", f, fn)) {
 	b = getenv(buf);
@@ -1751,3 +1722,46 @@ rpmExpandNumeric(const char *arg)
 
     return rc;
 }
+
+const char *
+rpmGetArchiver(const char *fn)
+{
+    rpmCompressedMagic compressed = COMPRESSED_OTHER;
+    const char *s = NULL;
+
+    rpmFileIsCompressed(fn, &compressed);
+
+    switch (compressed) {
+    default:
+    case COMPRESSED_NOT:
+	s = "%__cat ";
+	break;
+    case COMPRESSED_OTHER:
+	s = "%__gzip -dc ";
+	break;
+    case COMPRESSED_BZIP2:
+	s = "%__bzip2 -dc ";
+	break;
+    case COMPRESSED_ZIP:
+	s = "%__unzip ";
+	break;
+    case COMPRESSED_LZMA:
+    case COMPRESSED_XZ:
+	s = "%__xz -dc ";
+	break;
+    case COMPRESSED_LZIP:
+	s = "%__lzip -dc ";
+	break;
+    case COMPRESSED_LRZIP:
+	s = "%__lrzip -dqo- ";
+	break;
+    case COMPRESSED_7ZIP:
+	s = "%__7zip x ";
+	break;
+    case COMPRESSED_ZSTD:
+	s = "%__zstd -dc ";
+	break;
+    }
+
+    return s;
+}
diff --git a/rpmio/rpmio_internal.h b/rpmio/rpmio_internal.h
index 370cbdc75..5e9fb789f 100644
--- a/rpmio/rpmio_internal.h
+++ b/rpmio/rpmio_internal.h
@@ -47,6 +47,14 @@ int rpmioSlurp(const char * fn,
  */
 void rpmSetCloseOnExec(void);
 
+/** \ingroup rpmmacro
+ * Return a command line (without fn) for extracting the archive fn.
+ * Always returns a command line, even on failure.
+ * @param fn		filename of the archive
+ * @return		command line (with a trailing space)
+ */
+const char *rpmGetArchiver(const char *fn);
+
 #ifdef __cplusplus
 }
 #endif
-- 
