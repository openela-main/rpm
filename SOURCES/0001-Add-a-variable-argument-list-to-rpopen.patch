From 6edebd240f546525762887df73f4e1e05a896ede Mon Sep 17 00:00:00 2001
From: Michal Domonkos <mdomonko@redhat.com>
Date: Thu, 22 Oct 2026 09:11:51 +0200
Subject: [PATCH 1/5] Add a variable argument list to rpopen()

Accept multiple positional arguments for the shell instead of just one.
This will be needed in the next commits.

No functional change.

(cherry picked from commit e7a086a8e203f123fbd37ead9b52188d1302ce0e)
---
 tools/cliutils.c      | 9 +++++++--
 tools/cliutils.h      | 7 ++++---
 tools/rpmbuild.c      | 2 +-
 tools/rpmuncompress.c | 2 +-
 4 files changed, 13 insertions(+), 7 deletions(-)

diff --git a/tools/cliutils.c b/tools/cliutils.c
index 3be9b7233..bf135ba40 100644
--- a/tools/cliutils.c
+++ b/tools/cliutils.c
@@ -84,10 +84,11 @@ int finishPipe(void)
     return rc;
 }
 
-FILE* rpopen(const char *cmd, const char *arg)
+FILE* rpopen(const char *cmd, const char *arg, ...)
 {
     FILE *stream = NULL;
     ARGV_t argv = NULL;
+    va_list ap;
     int pipefd[2];
     pid_t pid;
 
@@ -98,7 +99,11 @@ FILE* rpopen(const char *cmd, const char *arg)
     argvAdd(&argv, "-c");
     argvAdd(&argv, cmd);
     argvAdd(&argv, "sh");
-    argvAdd(&argv, arg);
+
+    va_start(ap, arg);
+    for (const char *s = arg; s != NULL; s = va_arg(ap, const char *))
+	argvAdd(&argv, s);
+    va_end(ap);
 
     if ((pid = fork()) == 0) {
 	dup2(pipefd[1], STDOUT_FILENO);
diff --git a/tools/cliutils.h b/tools/cliutils.h
index cda4bebdf..4aee1ae72 100644
--- a/tools/cliutils.h
+++ b/tools/cliutils.h
@@ -23,10 +23,11 @@ int initPipe(void);
 int finishPipe(void);
 
 /*
- * A safe, read-only variant of popen(3) that passes untrusted input (arg) as a
- * positional argument to sh(1) where the command (cmd) can read it via $1.
+ * A safe, read-only variant of popen(3) that passes untrusted input (args) as
+ * positional arguments to sh(1) where the command (cmd) can read them via $1,
+ * $2, and so on.
  */
-FILE *rpopen(const char *cmd, const char *arg);
+FILE *rpopen(const char *cmd, const char *arg, ...) RPM_GNUC_NULL_TERMINATED;
 int rpclose(FILE *stream);
 
 #endif /* _CLIUTIL_H */
diff --git a/tools/rpmbuild.c b/tools/rpmbuild.c
index c5fbb085b..5074d61a7 100644
--- a/tools/rpmbuild.c
+++ b/tools/rpmbuild.c
@@ -388,7 +388,7 @@ static char * getTarSpec(const char *arg)
 			"%{__tar} xOvof - --wildcards ", *spec,
 			" 2>&1 > ", specFile, NULL);
 
-	if (!(fp = rpopen(cmd, arg))) {
+	if (!(fp = rpopen(cmd, arg, NULL))) {
 	    rpmlog(RPMLOG_ERR, _("Failed to open tar pipe: %m\n"));
 	} else {
 	    char *fok;
diff --git a/tools/rpmuncompress.c b/tools/rpmuncompress.c
index c0a4908ea..8b60c718d 100644
--- a/tools/rpmuncompress.c
+++ b/tools/rpmuncompress.c
@@ -280,7 +280,7 @@ int main(int argc, char *argv[])
 	    goto exit;
 	}
 
-	inp = rpopen(cmd, arg);
+	inp = rpopen(cmd, arg, NULL);
 	if (inp) {
 	    int status, c;
 	    while ((c = fgetc(inp)) != EOF)
