From 3d68be5f663e2174147f72eca55b0c6981ca0ad5 Mon Sep 17 00:00:00 2001
From: Michal Domonkos <mdomonko@redhat.com>
Date: Thu, 22 Oct 2026 10:46:11 +0200
Subject: [PATCH 5/5] Prevent shell injection via RubyGem filenames

Pass the archive's basename as a positional argument to the shell via
rpopen() in order to avoid shell injection via crafted .gem filenames.
This fixes a thinko in commit 7a4111bc5db4053e5381b65306903837763e7f11
where this one remaining code path was missed.

Make it the first positional argument ($1) and the existing filename the
second ($2), to mirror the parameter order in doUntar().

Adjust the --dry-run mode accordingly so that we print the real basename
there. This has a cosmetic effect on the printed shell command: it moves
the closing single quote in front of the .gemspec suffix, but since the
suffix is controlled by us, it doesn't matter and the result would be
the same as before if the user actually invoked the command. Therefore,
just fix the test.

Enable the respective test for this flaw as well.

Related: CVE-2026-84838

Backported from commit e95f1b29ae274620700d51d1741bf1392bfec0d8.
---
 tools/rpmuncompress.c | 14 +++++++++-----
 1 file changed, 9 insertions(+), 5 deletions(-)

diff --git a/tools/rpmuncompress.c b/tools/rpmuncompress.c
index c99c334da..46fb7c978 100644
--- a/tools/rpmuncompress.c
+++ b/tools/rpmuncompress.c
@@ -209,7 +209,7 @@ static char *doUntar(archiveType *at, int sr, const char *bn, const char *fn)
 	} else if (at->compressed == COMPRESSED_GEM) {
 	    char *gem = rpmGetPath("%{__gem}", NULL);
 
-	    rasprintf(&buf, "%s %s && %s spec %s --ruby > '%s.gemspec'",
+	    rasprintf(&buf, "%s %s && %s spec %s --ruby > %s.gemspec",
 			zipper, fn, gem, fn, bn);
 
 	    free(gem);
@@ -247,7 +247,8 @@ int main(int argc, char *argv[])
     int ec = EXIT_FAILURE;
     poptContext optCon = NULL;
     const char *arg = NULL;
-    const char *fnarg = "\"$1\"";
+    const char *bnarg = "\"$1\"";
+    const char *fnarg = "\"$2\"";
     char *bn = NULL;
     char *cmd = NULL;
     archiveType *at = NULL;
@@ -265,7 +266,7 @@ int main(int argc, char *argv[])
     if (extract) {
 	if (dstpath)
 	    sr = singleRoot(arg);
-	cmd = doUntar(at, sr, bn, fnarg);
+	cmd = doUntar(at, sr, bnarg, fnarg);
     } else {
 	cmd = doUncompress(at, fnarg);
     }
@@ -274,14 +275,17 @@ int main(int argc, char *argv[])
 	FILE *inp = NULL;
 
 	if (verbose || dryrun) {
+	    char *drybn = NULL;
 	    char *dryfn = NULL;
 	    char *drycmd = NULL;
+	    rasprintf(&drybn, "'%s'", bn);
 	    rasprintf(&dryfn, "'%s'", arg);
-	    drycmd = extract ? doUntar(at, sr, bn, dryfn) :
+	    drycmd = extract ? doUntar(at, sr, drybn, dryfn) :
 			       doUncompress(at, dryfn);
 	    fprintf(stderr, "%s\n", drycmd);
 	    free(drycmd);
 	    free(dryfn);
+	    free(drybn);
 	}
 
 	if (dryrun) {
@@ -289,7 +293,7 @@ int main(int argc, char *argv[])
 	    goto exit;
 	}
 
-	inp = rpopen(cmd, arg, NULL);
+	inp = rpopen(cmd, bn, arg, NULL);
 	if (inp) {
 	    int status, c;
 	    while ((c = fgetc(inp)) != EOF)
