From 5978f67c6e600fb39aade9c0dc53beb4870fab95 Mon Sep 17 00:00:00 2001
From: Michal Domonkos <mdomonko@redhat.com>
Date: Thu, 22 Oct 2026 09:56:27 +0200
Subject: [PATCH 4/5] Rename a parameter name in doUntar()

Now that the basename parameter is called "bn", rename "arg" (filename)
to "fn" for consistency and readability. Do the same in the --dry-run
branch while at it.

No functional change.

Backported from commit 1df4f546881b30251bfa0d281481607e49212074.
---
 tools/rpmuncompress.c | 20 ++++++++++----------
 1 file changed, 10 insertions(+), 10 deletions(-)

diff --git a/tools/rpmuncompress.c b/tools/rpmuncompress.c
index decf7d792..c99c334da 100644
--- a/tools/rpmuncompress.c
+++ b/tools/rpmuncompress.c
@@ -152,7 +152,7 @@ afree:
 	return ret;
 }
 
-static char *doUntar(archiveType *at, int sr, const char *bn, const char *arg)
+static char *doUntar(archiveType *at, int sr, const char *bn, const char *fn)
 {
     char *buf = NULL;
     char *tar = NULL;
@@ -205,20 +205,20 @@ static char *doUntar(archiveType *at, int sr, const char *bn, const char *arg)
 			   at->cmd, " ", at->unpack, " ",
 			   verbose ? "" : at->quiet, NULL);
 	if (needtar) {
-	    rasprintf(&buf, "%s %s %s | %s %s - %s", mkdir, zipper, arg, tar, taropts, stripcd);
+	    rasprintf(&buf, "%s %s %s | %s %s - %s", mkdir, zipper, fn, tar, taropts, stripcd);
 	} else if (at->compressed == COMPRESSED_GEM) {
 	    char *gem = rpmGetPath("%{__gem}", NULL);
 
 	    rasprintf(&buf, "%s %s && %s spec %s --ruby > '%s.gemspec'",
-			zipper, arg, gem, arg, bn);
+			zipper, fn, gem, fn, bn);
 
 	    free(gem);
 	} else {
-	    rasprintf(&buf, "%s%s %s %s", mkdir, zipper, arg, stripcd);
+	    rasprintf(&buf, "%s%s %s %s", mkdir, zipper, fn, stripcd);
 	}
 	free(zipper);
     } else {
-	rasprintf(&buf, "%s %s %s %s %s", mkdir, tar, taropts, arg, stripcd);
+	rasprintf(&buf, "%s %s %s %s %s", mkdir, tar, taropts, fn, stripcd);
     }
 
 exit:
@@ -274,14 +274,14 @@ int main(int argc, char *argv[])
 	FILE *inp = NULL;
 
 	if (verbose || dryrun) {
-	    char *dryarg = NULL;
+	    char *dryfn = NULL;
 	    char *drycmd = NULL;
-	    rasprintf(&dryarg, "'%s'", arg);
-	    drycmd = extract ? doUntar(at, sr, bn, dryarg) :
-			       doUncompress(at, dryarg);
+	    rasprintf(&dryfn, "'%s'", arg);
+	    drycmd = extract ? doUntar(at, sr, bn, dryfn) :
+			       doUncompress(at, dryfn);
 	    fprintf(stderr, "%s\n", drycmd);
 	    free(drycmd);
-	    free(dryarg);
+	    free(dryfn);
 	}
 
 	if (dryrun) {
-- 
2.56.0

