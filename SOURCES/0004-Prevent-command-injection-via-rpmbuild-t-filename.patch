From c98ecba7245ab622cddcc1810246a2ed1c963239 Mon Sep 17 00:00:00 2001
From: Michal Domonkos <mdomonko@redhat.com>
Date: Mon, 7 Sep 2026 14:41:39 +0200
Subject: [PATCH 4/4] Prevent command injection via rpmbuild -t filename

Commit 2a11eb3e4e51094082e0123aebd797ec051dc094 fixed command injection
via spec file entries, but there's another case where we pass some data
controlled by the tarball through macro or shell expansion: the filename
argument itself.

This happens in three places during tarball decompression: the first two
are in getTarSpec() where we construct and execute the shell command for
spec file extraction using rpmExpand() and popen(3), respectively, which
leads to the third one where we execute the actual decompression utility
using popen(3) in rpmuncompress. The filename gets passed through all of
these steps, and can cause arbitrary shell code execution in each one.

Fix that by passing the filename as a positional argument when invoking
the shell so that the command can reference it through the hardcoded $1
parameter instead of the filename directly. Add our own popen(3) version
for this purpose that takes an additional argument to be passed as $1 to
the shell, to preserve the surrounding logic and keep the patch minimal.
Hardcode /bin/sh as the shell since that's what popen(3) claims to do.

Don't bother with write mode support like the original function, though,
it can always be added later if this new version turns out to be useful
elsewhere. Add also a pclose(3) equivalent, just for consistency, since
the original call would probably work fine when passed the FILE stream
created by us.

Adjust the rpmuncompress output when in verbose/dry mode so that it is
preserved exactly. That means, generate the shell command again but this
time with the actual filename (enclosed in single quotes), and use that
for printing. Note that this has to happen in *addition* to the default
command that uses $1 since we need both variants when in verbose mode.

Enable the tests added in the previous commit as they are now expected
to pass.

Long-term, a better solution would be to split the shell commands such
that the simple program invocations that need the filename can be done
with a plain fork-exec instead of popen(3), or better yet, to just port
the internals to libarchive. But either is much more complex and would
make the patch more difficult to backport, so let's just stick with the
uglier fix for now.

Fixes: CVE-2026-84837, CVE-2026-84838
(backported from commit 7a4111bc5db4053e5381b65306903837763e7f11)
---
 tools/CMakeLists.txt  |  2 +-
 tools/cliutils.c      | 48 +++++++++++++++++++++++++++++++++++++++++++
 tools/cliutils.h      |  7 +++++++
 tools/rpmbuild.c      |  6 +++---
 tools/rpmuncompress.c | 38 +++++++++++++++++++++-------------
 5 files changed, 83 insertions(+), 18 deletions(-)

diff --git a/tools/CMakeLists.txt b/tools/CMakeLists.txt
index ea452e738..ba2d1706f 100644
--- a/tools/CMakeLists.txt
+++ b/tools/CMakeLists.txt
@@ -11,7 +11,7 @@ add_executable(rpmspec rpmspec.c cliutils)
 add_executable(rpmdeps rpmdeps.c)
 add_executable(rpmgraph rpmgraph.c)
 add_executable(rpmlua rpmlua.c)
-add_executable(rpmuncompress rpmuncompress.c)
+add_executable(rpmuncompress rpmuncompress.c cliutils)
 add_executable(rpmdump rpmdump.c)
 
 target_link_libraries(rpmsign PRIVATE librpmsign)
diff --git a/tools/cliutils.c b/tools/cliutils.c
index dc630bc8d..3be9b7233 100644
--- a/tools/cliutils.c
+++ b/tools/cliutils.c
@@ -83,3 +83,51 @@ int finishPipe(void)
     }
     return rc;
 }
+
+FILE* rpopen(const char *cmd, const char *arg)
+{
+    FILE *stream = NULL;
+    ARGV_t argv = NULL;
+    int pipefd[2];
+    pid_t pid;
+
+    if (pipe(pipefd) < 0)
+	goto exit;
+
+    argvAdd(&argv, "/bin/sh");
+    argvAdd(&argv, "-c");
+    argvAdd(&argv, cmd);
+    argvAdd(&argv, "sh");
+    argvAdd(&argv, arg);
+
+    if ((pid = fork()) == 0) {
+	dup2(pipefd[1], STDOUT_FILENO);
+	close(pipefd[0]);
+	execv(argv[0], argv);
+	_exit(EXIT_FAILURE);
+    } else if (pid == -1) {
+	goto exit;
+    }
+
+    close(pipefd[1]);
+    stream = fdopen(pipefd[0], "r");
+
+exit:
+    argvFree(argv);
+    return stream;
+}
+
+int rpclose(FILE *stream)
+{
+    int rc = -1;
+    int status;
+
+    if ((waitpid(-1, &status, 0) == -1) || !WIFEXITED(status))
+	goto exit;
+
+    rc = WEXITSTATUS(status);
+
+exit:
+    fclose(stream);
+    return rc;
+}
diff --git a/tools/cliutils.h b/tools/cliutils.h
index b5deee1ba..cda4bebdf 100644
--- a/tools/cliutils.h
+++ b/tools/cliutils.h
@@ -22,4 +22,11 @@ int initPipe(void);
 
 int finishPipe(void);
 
+/*
+ * A safe, read-only variant of popen(3) that passes untrusted input (arg) as a
+ * positional argument to sh(1) where the command (cmd) can read it via $1.
+ */
+FILE *rpopen(const char *cmd, const char *arg);
+int rpclose(FILE *stream);
+
 #endif /* _CLIUTIL_H */
diff --git a/tools/rpmbuild.c b/tools/rpmbuild.c
index c86a3ab23..c5fbb085b 100644
--- a/tools/rpmbuild.c
+++ b/tools/rpmbuild.c
@@ -384,11 +384,11 @@ static char * getTarSpec(const char *arg)
 	char *cmd;
 	int specfiles = 0;
 
-	cmd = rpmExpand("%{uncompress: ", arg, "} | ",
+	cmd = rpmExpand("%{uncompress: \"$1\" } | ",
 			"%{__tar} xOvof - --wildcards ", *spec,
 			" 2>&1 > ", specFile, NULL);
 
-	if (!(fp = popen(cmd, "r"))) {
+	if (!(fp = rpopen(cmd, arg))) {
 	    rpmlog(RPMLOG_ERR, _("Failed to open tar pipe: %m\n"));
 	} else {
 	    char *fok;
@@ -401,7 +401,7 @@ static char * getTarSpec(const char *arg)
 		}
 		specfiles++;
 	    }
-	    pclose(fp);
+	    rpclose(fp);
 	    gotspec = (specfiles == 1) && isSpecFile(specFile);
 	    if (specfiles > 1) {
 		rpmlog(RPMLOG_ERR, _("Found more than one spec file in %s\n"), arg);
diff --git a/tools/rpmuncompress.c b/tools/rpmuncompress.c
index 249bcfa3a..e555e0dd7 100644
--- a/tools/rpmuncompress.c
+++ b/tools/rpmuncompress.c
@@ -12,6 +12,7 @@
 #include <rpm/rpmcli.h>
 #include <rpm/rpmstring.h>
 
+#include "cliutils.h"
 #include "debug.h"
 
 static int verbose = 0;
@@ -76,14 +77,14 @@ static archiveType *getArchiver(const char *fn)
     return archiver;
 }
 
-static char *doUncompress(archiveType *at, const char *fn)
+static char *doUncompress(archiveType *at, const char *fn, const char *arg)
 {
     char *cmd = NULL;
     if (at) {
 	cmd = rpmExpand(at->setTZ ? "TZ=UTC " : "",
 			at->cmd, " ", at->unpack, NULL);
 	/* path must not be expanded */
-	cmd = rstrscat(&cmd, " '", fn, "'", NULL);
+	cmd = rstrscat(&cmd, " ", arg, NULL);
     }
     return cmd;
 }
@@ -151,7 +152,7 @@ afree:
 	return ret;
 }
 
-static char *doUntar(archiveType *at, int sr, const char *fn)
+static char *doUntar(archiveType *at, int sr, const char *fn, const char *arg)
 {
     char *buf = NULL;
     char *tar = NULL;
@@ -204,7 +205,7 @@ static char *doUntar(archiveType *at, int sr, const char *fn)
 			   at->cmd, " ", at->unpack, " ",
 			   verbose ? "" : at->quiet, NULL);
 	if (needtar) {
-	    rasprintf(&buf, "%s %s '%s' | %s %s - %s", mkdir, zipper, fn, tar, taropts, stripcd);
+	    rasprintf(&buf, "%s %s %s | %s %s - %s", mkdir, zipper, arg, tar, taropts, stripcd);
 	} else if (at->compressed == COMPRESSED_GEM) {
 	    char *tmp = xstrdup(fn);
 	    const char *bn = basename(tmp);
@@ -216,18 +217,18 @@ static char *doUntar(archiveType *at, int sr, const char *fn)
 	    rstrlcpy(gemnameversion, bn, nvlen);
 	    gemspec = rpmGetPath("", gemnameversion, ".gemspec", NULL);
 
-	    rasprintf(&buf, "%s '%s' && %s spec '%s' --ruby > '%s'",
-			zipper, fn, gem, fn, gemspec);
+	    rasprintf(&buf, "%s %s && %s spec %s --ruby > '%s'",
+			zipper, arg, gem, arg, gemspec);
 
 	    free(gemspec);
 	    free(gem);
 	    free(tmp);
 	} else {
-	    rasprintf(&buf, "%s%s '%s' %s", mkdir, zipper, fn, stripcd);
+	    rasprintf(&buf, "%s%s %s %s", mkdir, zipper, arg, stripcd);
 	}
 	free(zipper);
     } else {
-	rasprintf(&buf, "%s %s %s '%s' %s", mkdir, tar, taropts, fn, stripcd);
+	rasprintf(&buf, "%s %s %s %s %s", mkdir, tar, taropts, arg, stripcd);
     }
 
 exit:
@@ -242,6 +243,7 @@ int main(int argc, char *argv[])
     int ec = EXIT_FAILURE;
     poptContext optCon = NULL;
     const char *arg = NULL;
+    const char *fnarg = "\"$1\"";
     char *cmd = NULL;
     archiveType *at = NULL;
     int sr = 0;
@@ -257,28 +259,36 @@ int main(int argc, char *argv[])
     if (extract) {
 	if (dstpath)
 	    sr = singleRoot(arg);
-	cmd = doUntar(at, sr, arg);
+	cmd = doUntar(at, sr, arg, fnarg);
     } else {
-	cmd = doUncompress(at, arg);
+	cmd = doUncompress(at, arg, fnarg);
     }
 
     if (cmd) {
 	FILE *inp = NULL;
 
-	if (verbose || dryrun)
-	    fprintf(stderr, "%s\n", cmd);
+	if (verbose || dryrun) {
+	    char *dryarg = NULL;
+	    char *drycmd = NULL;
+	    rasprintf(&dryarg, "'%s'", arg);
+	    drycmd = extract ? doUntar(at, sr, arg, dryarg) :
+			       doUncompress(at, arg, dryarg);
+	    fprintf(stderr, "%s\n", drycmd);
+	    free(drycmd);
+	    free(dryarg);
+	}
 
 	if (dryrun) {
 	    ec = EXIT_SUCCESS;
 	    goto exit;
 	}
 
-	inp = popen(cmd, "r");
+	inp = rpopen(cmd, arg);
 	if (inp) {
 	    int status, c;
 	    while ((c = fgetc(inp)) != EOF)
 		fputc(c, stdout);
-	    status = pclose(inp);
+	    status = rpclose(inp);
 	    if (WIFEXITED(status) && WEXITSTATUS(status) == 0)
 		ec = EXIT_SUCCESS;
 	}
