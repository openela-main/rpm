     { "salvagedb", '\0', (POPT_ARG_VAL|POPT_ARGFLAG_OR|POPT_ARGFLAG_DOC_HIDDEN),
@@ -117,6 +120,9 @@ int main(int argc, char *argv[])
 	ec = rpmtsRebuildDB(ts);
