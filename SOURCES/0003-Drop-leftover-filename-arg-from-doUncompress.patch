From cc53ddd42c3255f4beb5bb514869c78b8147411f Mon Sep 17 00:00:00 2001
From: Michal Domonkos <mdomonko@redhat.com>
Date: Thu, 22 Oct 2026 13:55:57 +0200
Subject: [PATCH 3/5] Drop leftover filename arg from doUncompress()

This should've been part of commit
7a4111bc5db4053e5381b65306903837763e7f11.

No functional change.

Backported from commit 32c6dc786e09a3ea47a35f3657ca51e807ad0b20.
---
 tools/rpmuncompress.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/tools/rpmuncompress.c b/tools/rpmuncompress.c
index 923e66db2..decf7d792 100644
--- a/tools/rpmuncompress.c
+++ b/tools/rpmuncompress.c
@@ -77,7 +77,7 @@ static archiveType *getArchiver(const char *fn)
     return archiver;
 }
 
-static char *doUncompress(archiveType *at, const char *fn, const char *arg)
+static char *doUncompress(archiveType *at, const char *arg)
 {
     char *cmd = NULL;
     if (at) {
@@ -267,7 +267,7 @@ int main(int argc, char *argv[])
 	    sr = singleRoot(arg);
 	cmd = doUntar(at, sr, bn, fnarg);
     } else {
-	cmd = doUncompress(at, arg, fnarg);
+	cmd = doUncompress(at, fnarg);
     }
 
     if (cmd) {
@@ -278,7 +278,7 @@ int main(int argc, char *argv[])
 	    char *drycmd = NULL;
 	    rasprintf(&dryarg, "'%s'", arg);
 	    drycmd = extract ? doUntar(at, sr, bn, dryarg) :
-			       doUncompress(at, arg, dryarg);
+			       doUncompress(at, dryarg);
 	    fprintf(stderr, "%s\n", drycmd);
 	    free(drycmd);
 	    free(dryarg);
-- 
